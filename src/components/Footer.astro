---
import Logo from './Logo.astro';
import { CHANNEL_URL } from '../data/videos';
const b = import.meta.env.BASE_URL;
---
<footer>
  <Logo size={48}/>
  <p><strong>W3B HEX OFFICIAL</strong> — web news, awareness & scam alerts.</p>
  <p class="links"><a href={b}>Home</a> · <a href={b+'videos/'}>Videos</a> · <a href={b+'blog/'}>Blog</a> · <a href={b+'about/'}>About</a> · <a href={CHANNEL_URL} target="_blank" rel="noopener">YouTube</a></p>
  <p class="muted">© {new Date().getFullYear()} W3B HEX OFFICIAL. Stay sharp, stay safe ⚡</p>
</footer>
<style>footer{text-align:center;padding:3rem 1rem;border-top:1px solid #a855f733;margin-top:4rem;background:linear-gradient(#09090B,#12121a)}.links a{color:var(--cyan)}</style>
